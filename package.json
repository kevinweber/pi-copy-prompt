{
  "name": "@kevinweber/pi-copy-prompt",
  "version": "1.0.0",
  "description": "Copy the full expanded Pi editor draft to the clipboard with super+y",
  "keywords": ["pi-package", "pi", "pi-extension", "pi-coding-agent", "clipboard", "copy-prompt", "editor"],
  "author": "Kevin Weber",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "files": ["src/index.ts", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/kevinweber/pi-copy-prompt.git" },
  "homepage": "https://github.com/kevinweber/pi-copy-prompt#readme",
  "bugs": { "url": "https://github.com/kevinweber/pi-copy-prompt/issues" },
  "pi": { "extensions": ["./src/index.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "check": "node --check src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/index.test.mjs",
    "prepublishOnly": "npm run ci",
    "ci": "npm run check && npm run typecheck && npm run test"
  }
}
